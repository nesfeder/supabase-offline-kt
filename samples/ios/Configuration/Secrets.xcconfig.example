// Copy this file to Secrets.xcconfig, beside it, and fill it in. Git ignores Secrets.xcconfig, so
// the values never reach a commit. Without it the app opens in demo mode.
//
// The project URL without `https://`: an xcconfig reads `//` as the start of a comment.
SUPABASE_URL = your-project-ref.supabase.co
// The publishable key (sb_publishable_…), never the secret key.
SUPABASE_PUBLISHABLE_KEY = sb_publishable_your-key

// To run on a device, your team and a bundle identifier of your own:
// DEVELOPMENT_TEAM = ABCDE12345
// OFFLINE_TASKS_BUNDLE_IDENTIFIER = com.example.offlinetasks
