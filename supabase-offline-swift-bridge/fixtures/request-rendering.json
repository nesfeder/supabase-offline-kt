    {
      "name": "pattern lists and text search",
      "call": "select",
      "description": {
        "v": 1,
        "table": "notes",
        "filters": [
          {"kind": "likeAll", "column": "body", "patterns": ["%cat%", "%dog%"]},
          {"kind": "ilikeAny", "column": "title", "patterns": ["a%", "b%"]},
          {"kind": "textSearch", "column": "tsv", "query": "cat & dog", "type": "websearch", "config": "english"},
          {"kind": "filter", "column": "summary", "operator": "fts", "value": "cat"}
