{
  "version": 1,
  "about": [
    "Descriptions the Swift package hands the bridge, and the request each must produce: the",
    "method, the path, every query parameter in order (decoded), the headers listed (a header sent",
    "more than once joined with commas, as BridgeHttpRequest joins it), and the body",
    "as JSON. A case with an error names the BridgeErrorKind it must fail with before anything is",
    "sent. The bridge's Kotlin tests and the Swift package's tests both read this file, so the two",
    "sides cannot drift apart. Filter values are text, as the Swift side renders them: UUIDs in",
    "lower case, dates as ISO 8601 in UTC."
  ],
  "baseUrl": "https://fixture.supabase.co",
  "cases": [
    {
      "name": "every column, by default",
      "call": "select",
      "description": {"v": 1, "table": "todos", "strategy": {"kind": "networkOnly"}},
      "request": {
        "method": "GET",
        "path": "/rest/v1/todos",
        "query": [["select", "*"]],
        "headers": {"Accept-Profile": "public", "Prefer": ""}
      }
    },
    {
      "name": "columns lose the spaces outside quotes",
      "call": "select",
      "description": {"v": 1, "table": "todos", "columns": "id, title, \"due date\"", "strategy": {"kind": "networkOnly"}},
      "request": {
        "method": "GET",
        "path": "/rest/v1/todos",
        "query": [["select", "id,title,\"due date\""]]
      }
    },
    {
      "name": "a boolean as text, newest first, twenty rows",
      "call": "select",
      "description": {
        "v": 1,
        "table": "todos",
        "columns": "id,title,done",
        "filters": [{"kind": "filter", "column": "done", "operator": "eq", "value": "false"}],
        "modifiers": [
          {"kind": "order", "column": "created_at", "ascending": false},
          {"kind": "limit", "count": 20}
        ],
        "strategy": {"kind": "networkFirst", "maxAgeMillis": 60000}
      },
      "request": {
        "method": "GET",
        "path": "/rest/v1/todos",
        "query": [
          ["done", "eq.false"],
          ["order", "created_at.desc.nullslast"],
          ["limit", "20"],
          ["select", "id,title,done"]
        ]
      }
    },
    {
      "name": "the comparison operators",
      "call": "select",
      "description": {
        "v": 1,
        "table": "todos",
        "filters": [
          {"kind": "filter", "column": "priority", "operator": "gte", "value": "2"},
          {"kind": "filter", "column": "score", "operator": "lt", "value": "9.5"},
          {"kind": "filter", "column": "title", "operator": "ilike", "value": "%milk%"},
          {"kind": "filter", "column": "owner", "operator": "neq", "value": "7d6f0c52-9d7e-4b8e-9f51-3c1e2f0a9b11"},
          {"kind": "filter", "column": "due", "operator": "lte", "value": "2026-10-04T12:00:00Z"}
        ],
        "strategy": {"kind": "networkOnly"}
      },
      "request": {
        "method": "GET",
        "path": "/rest/v1/todos",
        "query": [
          ["priority", "gte.2"],
          ["score", "lt.9.5"],
          ["title", "ilike.%milk%"],
          ["owner", "neq.7d6f0c52-9d7e-4b8e-9f51-3c1e2f0a9b11"],
          ["due", "lte.2026-10-04T12:00:00Z"],
          ["select", "*"]
        ]
      }
    },
