        "strategy": {"kind": "networkOnly"}
      },
      "request": {
        "method": "GET",
        "path": "/rest/v1/notes",
        "query": [
          ["body", "like(all).{%cat%,%dog%}"],
          ["title", "ilike(any).{a%,b%}"],
          ["tsv", "wfts(english).cat & dog"],
          ["summary", "fts.cat"],
          ["select", "*"]
        ]
      }
